Subject: Allow package builds to provide the release version

PGXN source archives do not retain the Git metadata that upstream's version
helper uses.  Preserve the upstream fallback for ad-hoc builds while allowing
the DEB/RPM recipes to compile the verified package release version into the
extension and exported telemetry resource attributes.

--- a/cmake/GitVersion.cmake
+++ b/cmake/GitVersion.cmake
@@ -5,6 +5,11 @@
 #   GIT_VERSION - Version string from git describe, or fallback
 
 function(get_git_version output_var)
+  if(DEFINED PG_STAT_CH_PACKAGE_VERSION)
+    set(${output_var} "${PG_STAT_CH_PACKAGE_VERSION}" PARENT_SCOPE)
+    return()
+  endif()
+
   set(fallback_version "0.1")
 
   find_package(Git QUIET)

--- a/triplets/arm64-linux-pic.cmake
+++ b/triplets/arm64-linux-pic.cmake
@@ -3,5 +3,6 @@ set(VCPKG_CMAKE_SYSTEM_NAME Linux)
 set(VCPKG_CRT_LINKAGE dynamic)
 set(VCPKG_LIBRARY_LINKAGE static)
+set(VCPKG_BUILD_TYPE release)
 set(VCPKG_CXX_FLAGS "-fPIC")
 set(VCPKG_C_FLAGS "-fPIC")
 

--- a/triplets/x64-linux-pic.cmake
+++ b/triplets/x64-linux-pic.cmake
@@ -3,8 +3,16 @@ set(VCPKG_CMAKE_SYSTEM_NAME Linux)
 set(VCPKG_CRT_LINKAGE dynamic)
 set(VCPKG_LIBRARY_LINKAGE static)
+set(VCPKG_BUILD_TYPE release)
 set(VCPKG_CXX_FLAGS "-fPIC")
 set(VCPKG_C_FLAGS "-fPIC")
 
+# EL10's x86-64-v3 flags enable Snappy's AVX copy path while its vcpkg
+# configuration disables the BMI2 path that normally includes this header.
+# Keep the workaround local to Snappy instead of changing the platform ISA.
+if(PORT STREQUAL "snappy")
+  set(VCPKG_CXX_FLAGS "${VCPKG_CXX_FLAGS} -include immintrin.h")
+endif()
+
 # Link OpenSSL dynamically: PG dlopens extensions RTLD_GLOBAL, so SSL-enabled
 # backends' system libssl.so.3 interposes an embedded copy anyway; dynamic
 # linkage makes that explicit and leaves CVE patching to distro
