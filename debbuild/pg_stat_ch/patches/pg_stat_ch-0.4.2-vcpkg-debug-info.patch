Subject: Retain DWARF for statically linked vcpkg dependency code

Release mode is already selected upstream. Add only debug information;
retain optimization and let RPM/dh_strip split the final shared object.

--- a/triplets/arm64-linux-pic.cmake
+++ b/triplets/arm64-linux-pic.cmake
@@ -2,8 +2,8 @@
 set(VCPKG_CMAKE_SYSTEM_NAME Linux)
 set(VCPKG_CRT_LINKAGE dynamic)
 set(VCPKG_LIBRARY_LINKAGE static)
-set(VCPKG_CXX_FLAGS "-fPIC")
-set(VCPKG_C_FLAGS "-fPIC")
+set(VCPKG_CXX_FLAGS "-fPIC -g")
+set(VCPKG_C_FLAGS "-fPIC -g")
 set(VCPKG_BUILD_TYPE release)
 
 # Link OpenSSL dynamically: PG dlopens extensions RTLD_GLOBAL, so SSL-enabled
