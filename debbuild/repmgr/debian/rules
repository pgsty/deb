#!/usr/bin/make -f

export USE_PGXS = 1
export DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk
include /usr/share/postgresql-common/pgxs_debian_control.mk

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_clean:

override_dh_auto_install:
	set -e; for v in $$(pg_buildext supported-versions); do \
	  PG_CONFIG=/usr/lib/postgresql/$$v/bin/pg_config ./configure; \
	  $(MAKE) PG_CONFIG=/usr/lib/postgresql/$$v/bin/pg_config clean; \
	  LIBRARY_PATH=/usr/lib/postgresql/$$v/lib $(MAKE) PG_CONFIG=/usr/lib/postgresql/$$v/bin/pg_config; \
	  LIBRARY_PATH=/usr/lib/postgresql/$$v/lib $(MAKE) PG_CONFIG=/usr/lib/postgresql/$$v/bin/pg_config install DESTDIR=$(CURDIR)/debian/postgresql-$$v-repmgr; \
	done
	rm -rf debian/postgresql-*-repmgr/usr/share/doc/postgresql-doc-*/

override_dh_installdocs:
	dh_installdocs --all README.md
