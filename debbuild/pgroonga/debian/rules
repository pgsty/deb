#!/usr/bin/make -f

include /usr/share/postgresql-common/pgxs_debian_control.mk

# PGroonga 4.0.8 removed the legacy top-level Makefile in favor of Meson.
# Build each active PostgreSQL ABI independently rather than installing a
# module compiled against whichever pg_config is first on PATH.
override_dh_auto_configure:
	:

override_dh_auto_build:
	:

override_dh_auto_install:
	set -e; \
	for version in $$(cat debian/pgversions); do \
		meson setup --wipe build-$$version \
			-Dinstall_to_postgresql=true \
			-Dmessage_pack=enabled \
			-Dtest=false \
			-Dxxhash=enabled \
			-Dpg_config=/usr/lib/postgresql/$$version/bin/pg_config; \
		meson compile -C build-$$version; \
		DESTDIR=$(CURDIR)/debian/postgresql-$$version-pgroonga meson install -C build-$$version; \
		printf 'postgresql:Depends=postgresql-%s\n' $$version > debian/postgresql-$$version-pgroonga.substvars; \
	done

override_dh_installdocs:


%:
	dh $@
