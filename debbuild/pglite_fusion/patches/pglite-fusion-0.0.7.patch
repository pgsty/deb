diff --git a/sql/pglite_fusion--0.0.6--0.0.7.sql b/sql/pglite_fusion--0.0.6--0.0.7.sql
new file mode 100644
index 0000000..27f6aed
--- /dev/null
+++ b/sql/pglite_fusion--0.0.6--0.0.7.sql
@@ -0,0 +1,7 @@
+-- pglite_fusion 0.0.6 -> 0.0.7
+--
+-- Version 0.0.7 updates rusqlite and its internal MAIN_DB API without
+-- changing the PostgreSQL type or function catalog. The PostgreSQL datum
+-- remains the same serde_cbor-encoded Sqlite struct whose byte vector contains
+-- the standard SQLite database image, so the catalog edge is a no-op.
+SELECT 1;
