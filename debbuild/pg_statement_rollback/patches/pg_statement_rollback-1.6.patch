+/*
+ * SET TRANSACTION must run outside our automatic subtransaction.  Releasing
+ * the savepoint from ProcessUtility is too late: a Portal and its resource
+ * owner already exist below that subtransaction, and subcommit marks that
+ * owner released while the portal survives.  The next parse then fails in
+ * ResourceOwnerEnlarge.  post_parse_analyze runs before Portal creation in
+ * both simple and extended query protocols, so release the savepoint here.
+ */
+#if PG_VERSION_NUM >= 140000
+static void
+slr_post_parse_analyze(ParseState *pstate, Query *query, JumbleState *jstate)
+#else
+static void
+slr_post_parse_analyze(ParseState *pstate, Query *query)
+#endif
+{
+	if (prev_post_parse_analyze_hook)
+#if PG_VERSION_NUM >= 140000
+		prev_post_parse_analyze_hook(pstate, query, jstate);
+#else
+		prev_post_parse_analyze_hook(pstate, query);
+#endif
+
+	if (slr_enabled && slr_pending && slr_nest_executor_level == 0 &&
+		query != NULL && query->commandType == CMD_UTILITY &&
+		IsA(query->utilityStmt, VariableSetStmt))
+	{
+		VariableSetStmt *setstmt = (VariableSetStmt *) query->utilityStmt;
+
+		if (setstmt->name != NULL &&
+			(strcmp(setstmt->name, "TRANSACTION") == 0 ||
+			 strcmp(setstmt->name, "TRANSACTION SNAPSHOT") == 0))
+			slr_release_savepoint();
+	}
+}
