-         * the colon later*/
-        token = strtok(tmp, " ");
+    if (!colon || colon == line || (len >= 5 && memcmp(line, "HTTP/", 5) == 0))
+        return;
+    value = colon + 1;
+    while (value < end && (*value == ' ' || *value == '\t'))
+        value++;
+    while (end > value && (end[-1] == '\r' || end[-1] == '\n' ||
+                           end[-1] == ' ' || end[-1] == '\t'))
+        end--;
+    key.type = val.type = jbvString;
+    key.val.string.len = colon - line;
+    key.val.string.val = pnstrdup(line, key.val.string.len);
+    val.val.string.len = end - value;
+    val.val.string.val = pnstrdup(value, val.val.string.len);
+    pushJsonbValue(state, WJB_KEY, &key);
+    pushJsonbValue(state, WJB_VALUE, &val);
+}
 
