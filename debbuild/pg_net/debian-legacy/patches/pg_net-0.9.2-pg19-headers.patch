+/* libcurl supplies a length-delimited field line. Keep its text until the
+ * response object has been finalized. The status and separator lines have
+ * no field name. */
+void parseHeaders(const char *line, size_t len, HeaderState *state) {
+    const char *colon = memchr(line, ':', len);
+    const char *end = line + len;
+    const char *value;
     JsonbValue key, val;
 
-    if (!firstLine && !lastLine) {
-        /*The header comes as "Header-Key: val", split by whitespace and
