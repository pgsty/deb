Subject: Adapt sqlite_fdw to PostgreSQL 19 declarations and instrumentation

Extend the build version check, include used declarations, select NodeInstrumentation, and convert Datums before varlena access.

--- a/Makefile
+++ b/Makefile
@@ -37,8 +37,8 @@
 ifndef MAJORVERSION
 MAJORVERSION := $(basename $(VERSION))
 endif
-ifeq (,$(findstring $(MAJORVERSION), 13 14 15 16 17 18))
-$(error PostgreSQL 13, 14, 15, 16, 17 or 18 is required to compile this extension)
+ifeq (,$(findstring $(MAJORVERSION), 13 14 15 16 17 18 19))
+$(error PostgreSQL 13, 14, 15, 16, 17, 18 or 19 is required to compile this extension)
 endif
 
 else

--- a/sqlite_fdw.h
+++ b/sqlite_fdw.h
