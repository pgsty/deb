#!/usr/bin/make -f

export CC = gcc
include /usr/share/postgresql-common/pgxs_debian_control.mk

%:
	dh $@

override_dh_auto_build:

override_dh_auto_test:
	# Runtime regression tests run against an isolated installed-package cluster.

override_dh_auto_install:
	# Upstream's first target starts a test cluster; packaging must select all.
	+pg_buildext -m '.DEFAULT_GOAL=all DOCS=' loop postgresql-%v-pg-grammar-guard
	rm -rf debian/postgresql-*-pg-grammar-guard/usr/share/doc/postgresql-doc-*/

override_dh_installdocs:
	dh_installdocs --all README.md
