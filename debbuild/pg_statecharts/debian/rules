#!/usr/bin/make -f

include /usr/share/postgresql-common/pgxs_debian_control.mk

%:
	dh $@

override_dh_auto_configure override_dh_auto_build override_dh_auto_test override_dh_auto_clean:

override_dh_auto_install:
	set -eu; for v in $$(pg_buildext supported-versions); do \
	  for ext in pg_statecharts pg_statecharts_dev; do \
	    pkg=$$(echo "$$ext" | tr '_' '-'); \
	    dest="$(CURDIR)/debian/postgresql-$$v-$$pkg/usr/share/postgresql/$$v/extension"; \
	    mkdir -p "$$dest"; DEST="$$dest" ./$$ext/install.sh; \
	  done; \
	done

override_dh_installdocs:
	dh_installdocs --all README.md
