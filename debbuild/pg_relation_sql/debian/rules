#!/usr/bin/make -f

PG_VERSIONS := $(shell tr '\n' ' ' < debian/pgversions)

%:
	dh $@

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_clean:

override_dh_auto_install:
	for PG_VERSION in $(PG_VERSIONS); do \
		FULL_NAME=postgresql-$$PG_VERSION-pg-relation-sql; \
		dh_installdirs -p$$FULL_NAME; \
		install -D -m 0644 relation_sql.sql \
			$(CURDIR)/debian/$$FULL_NAME/usr/share/postgresql/$$PG_VERSION/pg_relation_sql/relation_sql.sql; \
	done

override_dh_installdocs:
	dh_installdocs --all README.md CHANGELOG.md EXPLAIN.md
