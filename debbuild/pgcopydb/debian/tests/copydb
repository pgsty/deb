#!/bin/sh

set -eux

PGCOPYDB_TEST_DIR=$(mktemp -d)
export PGCOPYDB_TEST_DIR
trap 'rm -rf -- "$PGCOPYDB_TEST_DIR"' EXIT

pg_virtualenv <<'EOF'
  set -eux
  export PATH="${PG_CONFIG%/*}:$PATH"
  createdb src
  createdb dst
  psql -c 'create table foo as select 123+456' src
  HOME="$PGCOPYDB_TEST_DIR" pgcopydb clone --source "dbname=src" --target "dbname=dst" --dir "$PGCOPYDB_TEST_DIR/clone"
  pg_dump -t foo dst
  pg_dump -t foo dst | grep 579
EOF
