From: PGSTY packaging
Subject: Avoid an unnecessary private PostgreSQL library RUNPATH

--- a/src/pg/meson.build
+++ b/src/pg/meson.build
@@ -71,7 +71,8 @@
   include_directories: src_inc,
   name_prefix: '',
   build_rpath: pg_rpath.length() > 0 ? pg_rpath[0] : '',
-  install_rpath: pg_libdir,
+  # The backend resolves PostgreSQL symbols; BLAS uses the system path.
+  install_rpath: '',
   install: true,
   install_dir: pg_pkglibdir,
   # dlopen()'d, never exec'd -- match every other installed PostgreSQL
