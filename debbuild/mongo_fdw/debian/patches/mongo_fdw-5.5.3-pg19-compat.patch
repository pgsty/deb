Subject: Build mongo_fdw with PostgreSQL 19 headers

Select GNU C11, include math.h explicitly, and extend the upstream major-version check.

--- a/Makefile
+++ b/Makefile
@@ -18,7 +18,7 @@
 
 MONGO_INCLUDE = $(shell pkg-config --cflags libmongoc-1.0 libbson-1.0 2>/dev/null | sed -e 's;\(-I/usr/include/\([a-z]*\)-[^ ]*\);\1 \1/\2;g') \
                 $(shell pkg-config --cflags mongoc2 2>/dev/null | sed -e 's;\(-I/usr/include/\([a-z]*\)-[^ ]*\);\1 \1/\2;g')
-PG_CPPFLAGS = --std=c99 $(MONGO_INCLUDE) $(shell pkg-config --cflags json-c)
+PG_CPPFLAGS = --std=gnu11 $(MONGO_INCLUDE) $(shell pkg-config --cflags json-c)
 SHLIB_LINK = $(shell pkg-config --libs libmongoc-1.0 libbson-1.0 2>/dev/null) \
              $(shell pkg-config --libs mongoc2 2>/dev/null) \
              $(shell pkg-config --libs json-c)
@@ -46,8 +46,8 @@
     MAJORVERSION := $(basename $(VERSION))
 endif
 
-ifeq (,$(findstring $(MAJORVERSION), 13 14 15 16 17 18))
-    $(error PostgreSQL 13, 14, 15, 16, 17, or 18 is required to compile this extension)
+ifeq (,$(findstring $(MAJORVERSION), 13 14 15 16 17 18 19))
+    $(error PostgreSQL 13, 14, 15, 16, 17, 18, or 19 is required to compile this extension)
 endif
 
 else

--- a/mongo_fdw.c
+++ b/mongo_fdw.c
@@ -13,6 +13,7 @@
  *-------------------------------------------------------------------------
  */
 #include "postgres.h"
+#include <math.h>
 #include "mongo_wrapper.h"
 
 #include "access/htup_details.h"
