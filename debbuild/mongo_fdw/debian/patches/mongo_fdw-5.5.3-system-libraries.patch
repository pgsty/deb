Subject: Build with packaged MongoDB and JSON libraries

Use pkg-config for the system libraries and omit bundled json-c objects.
Before mongo-c-driver 1.30, map the renamed legacy JSON entry points and
remove flag to their original names. Preserve legacy Extended JSON output.

diff -urN orig/Makefile mod/Makefile
--- a/Makefile	2025-09-30 13:28:33.000000000 +0800
+++ b/Makefile	2026-06-19 21:25:14.881327052 +0800
@@ -16,11 +16,14 @@
                                 $(LIBJSON)/json_object_iterator.o $(LIBJSON)/printbuf.o $(LIBJSON)/linkhash.o \
                                 $(LIBJSON)/arraylist.o $(LIBJSON)/random_seed.o $(LIBJSON)/debug.o $(LIBJSON)/strerror_override.o
 
-MONGO_INCLUDE = $(shell pkg-config --cflags libmongoc-1.0)
-PG_CPPFLAGS = --std=c99 $(MONGO_INCLUDE) -I$(LIBJSON)
-SHLIB_LINK = $(shell pkg-config --libs libmongoc-1.0)
+MONGO_INCLUDE = $(shell pkg-config --cflags libmongoc-1.0 libbson-1.0 2>/dev/null | sed -e 's;\(-I/usr/include/\([a-z]*\)-[^ ]*\);\1 \1/\2;g') \
+                $(shell pkg-config --cflags mongoc2 2>/dev/null | sed -e 's;\(-I/usr/include/\([a-z]*\)-[^ ]*\);\1 \1/\2;g')
+PG_CPPFLAGS = --std=c99 $(MONGO_INCLUDE) $(shell pkg-config --cflags json-c)
+SHLIB_LINK = $(shell pkg-config --libs libmongoc-1.0 libbson-1.0 2>/dev/null) \
+             $(shell pkg-config --libs mongoc2 2>/dev/null) \
+             $(shell pkg-config --libs json-c)
 
-OBJS = connection.o option.o mongo_wrapper.o mongo_fdw.o mongo_query.o deparse.o $(LIBJSON_OBJS)
+OBJS = connection.o option.o mongo_wrapper.o mongo_fdw.o mongo_query.o deparse.o
 
 
 EXTENSION = mongo_fdw
--- a/mongo_wrapper.c
+++ b/mongo_wrapper.c
@@ -16,6 +16,16 @@
 
 #include <mongoc.h>
 #include "mongo_wrapper.h"
+
+/* libbson 1.30 renamed the legacy JSON entry points without changing format. */
+#if !BSON_CHECK_VERSION(1, 30, 0)
+#define bson_array_as_legacy_extended_json bson_array_as_json
+#define bson_as_legacy_extended_json bson_as_json
+#endif
+
+#if !MONGOC_CHECK_VERSION(1, 30, 0)
+#define MONGOC_DELETE_SINGLE_REMOVE MONGOC_REMOVE_SINGLE_REMOVE
+#endif
 
 #define ITER_TYPE(i) ((bson_type_t) * ((i)->raw + (i)->type))
 
