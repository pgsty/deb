Description: Preserve PG14 login-hook error diagnostics before aborting the transaction
Author: PGSTY
Forwarded: no
Last-Update: 2026-11-06

--- a/login_hook.c
+++ b/login_hook.c
@@ -26,6 +26,7 @@
 #include "utils/snapmgr.h"
 #include "utils/syscache.h"
 #include "utils/builtins.h"
+#include "utils/memutils.h"
 #include "catalog/pg_proc_d.h"
 
 #if PG_VERSION_NUM >= 190000
@@ -207,12 +208,35 @@
                 // Make sure function login_hook.is_executing_login_hook() will return false ever after
                 isExecutingLogin = false;
 #if PG_VERSION_NUM < 150000
+                /* AbortCurrentTransaction destroys transaction allocations and
+                 * invalidates catalog access. Preserve diagnostics first. */
+                ErrorData *edata;
+                char *errorDbName;
+                bool loginUserIsSuperuser = superuser();
+
+                MemoryContextSwitchTo(TopMemoryContext);
+                edata = CopyErrorData();
+                errorDbName = pstrdup(dbName);
+                FlushErrorState();
                 AbortCurrentTransaction();
                 startedATransaction = false;
+
+                if (loginUserIsSuperuser)
+                    ereport(WARNING,
+                            (errcode(edata->sqlerrcode),
+                             errmsg("Function login_hook.login() returned with error in database %s.\nPlease resolve the error as only superusers can login now.",
+                                    errorDbName),
+                             errhint("original message = %s", edata->message)));
+                else
+                    ereport(ERROR,
+                            (errmsg("Function login_hook.login() returned with error in database %s, only a superuser can login",
+                                    errorDbName)));
+
+                FreeErrorData(edata);
+                pfree(errorDbName);
 #else
                 RollbackAndReleaseCurrentSubTransaction();
                 startedATransaction = false;
-#endif
                 if (superuser())
                 {
                     ErrorData *edata = CopyErrorData();
@@ -243,6 +267,7 @@
 						 get_database_name(MyDatabaseId));
 #endif
                 }
+#endif
             }
             PG_END_TRY();
 	    }
