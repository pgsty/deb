#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS=hardening=+all
export ARROW_XSIMD_URL=file://$(CURDIR)/debian/xsimd-8.1.0.tar.gz
include /usr/share/dpkg/architecture.mk

%:
	dh $@ --sourcedirectory=cpp --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_CXX_STANDARD=17 \
		-DARROW_DEPENDENCY_SOURCE=SYSTEM \
		-Dxsimd_SOURCE=BUNDLED \
		-DARROW_BUILD_SHARED=ON -DARROW_BUILD_STATIC=OFF \
		-DARROW_COMPUTE=ON -DARROW_IPC=ON -DARROW_FILESYSTEM=ON \
		-DARROW_CSV=ON -DARROW_JSON=ON \
		-DARROW_PARQUET=OFF -DARROW_DATASET=OFF \
		-DARROW_JEMALLOC=OFF \
		-DARROW_WITH_BROTLI=ON -DARROW_WITH_BZ2=ON \
		-DARROW_WITH_LZ4=ON -DARROW_WITH_SNAPPY=ON \
		-DARROW_WITH_ZLIB=ON -DARROW_WITH_ZSTD=ON \
		-DARROW_INSTALL_LIB_DIR=lib/$(DEB_HOST_MULTIARCH) \
		-DCMAKE_SKIP_INSTALL_RPATH=ON

override_dh_makeshlibs:
	dh_makeshlibs -- -v9.0.0
