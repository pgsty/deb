Subject: Convert varlena Datums to pointers for PostgreSQL 19

Use DatumGetPointer at the four sketch update sites; leave serialized data and sketch behavior unchanged.

--- a/src/theta_sketch_pg_functions.c
+++ b/src/theta_sketch_pg_functions.c
@@ -105,7 +105,7 @@
   get_typlenbyvalalign(element_type, &typlen, &typbyval, &typalign);
   if (typlen == -1) {
     // varlena
-    theta_sketch_update(stateptr->ptr, VARDATA_ANY(element), VARSIZE_ANY_EXHDR(element));
+    theta_sketch_update(stateptr->ptr, VARDATA_ANY(DatumGetPointer(element)), VARSIZE_ANY_EXHDR(DatumGetPointer(element)));
   } else if (typbyval) {
     // fixed-length passed by value
     theta_sketch_update(stateptr->ptr, &element, typlen);
