Subject: Build the pinned bundled source without Git and order library installation

GitHub source archives have no submodule checkout metadata. Depend on the
included DuckDB tree, and create the PGXS library directory before installing
the bundled core. These changes do not alter runtime code or dependency pins.

--- a/Makefile
+++ b/Makefile
@@ -167,12 +167,9 @@
 src/pgduckdb_detoast.o: override CPPFLAGS += -DPGDUCKDB_BUNDLED_LZ4 -isystem third_party/duckdb/third_party/lz4
 endif
 
-# We need the DuckDB header files to build our own .o files. We depend on the
-# duckdb submodule HEAD, because that target pulls in the submodule which
-# includes those header files. This does mean that we rebuild our .o files
-# whenever we change the DuckDB version, but that seems like a fairly
-# reasonable thing to do anyway, even if not always strictly necessary always.
-$(OBJS): .git/modules/third_party/duckdb/HEAD
+# Distribution archives contain the exact pinned DuckDB source tree without Git
+# metadata; it is already present when the bridge objects are compiled.
+$(OBJS): third_party/duckdb/CMakeLists.txt
 
 COMPILE.cc.bc += $(PG_CPPFLAGS)
 COMPILE.cxx.bc += $(PG_CXXFLAGS)
@@ -217,10 +214,7 @@
 
 duckdb: $(FULL_DUCKDB_LIB)
 
-.git/modules/third_party/duckdb/HEAD:
-	git submodule update --init --recursive
-
-$(FULL_DUCKDB_LIB): .git/modules/third_party/duckdb/HEAD third_party/pg_duckdb_extensions.cmake
+$(FULL_DUCKDB_LIB): third_party/duckdb/CMakeLists.txt third_party/pg_duckdb_extensions.cmake
 	OVERRIDE_GIT_DESCRIBE=$(DUCKDB_VERSION) \
 	$(DUCKDB_DEPS_ENV) \
 	$(if $(DUCKDB_CC),CC="$(DUCKDB_CC)") $(if $(DUCKDB_CXX),CXX="$(DUCKDB_CXX)") \
@@ -242,6 +236,8 @@
 	$(install_bin) -m 755 $(FULL_DUCKDB_LIB) $(DESTDIR)$(PG_LIB)
 endif
 
+install-duckdb: | installdirs-lib
+
 clean-duckdb:
 	rm -rf third_party/duckdb/build
 
