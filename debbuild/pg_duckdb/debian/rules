#!/usr/bin/make -f

# Makefile only uses -Wno-maybe-uninitialized (needed on Ubuntu ppc64el) if CC=gcc
export CC = gcc
# Source archives have no Git metadata; keep the supported packaging scope.
export PG_DUCKDB_VERSION = v1.2.2
export PG_MIN_VER = 15
export PG_MAX_VER = 19
export DUCKDB_COMMIT = 8d78114e90a53823803660bf821f6073ac87da8c
# PGXS copies PG_CPPFLAGS before upstream's target-specific version assignment.
# Export the definition before including PGXS so PG18+ module metadata is valid.
ifneq ($(filter 18 19,$(shell pg_config --version | sed -n 's/^PostgreSQL \([0-9]*\).*/\1/p')),)
export PG_CPPFLAGS = -DPG_DUCKDB_VERSION=\"$(PG_DUCKDB_VERSION)\"
endif

# Keep the distribution debug, hardening, and reproducibility flags.  PGXS
# supplies the compiler-specific LTO mode itself (GCC for native objects and
# Clang for LLVM bitcode), so do not append dpkg's GCC LTO spelling to either
# the PG bridge or the bundled DuckDB build.
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk

PG_CFLAGS := $(filter-out -flto -flto=% -ffat-lto-objects,$(CFLAGS))
PG_CXXFLAGS := $(filter-out -flto -flto=% -ffat-lto-objects,$(CXXFLAGS))
# GCC's PGXS link defaults to -flto=auto, which ignores the two-job make
# boundary and starts one LTRANS worker per detected CPU.  The final command
# line value wins, so constrain only the native link here.  This variable is
# not used by PGXS's Clang bitcode compilation, which keeps -flto=thin.
PG_LDFLAGS := $(filter-out -flto -flto=% -ffat-lto-objects,$(LDFLAGS)) -flto=2

# Preserve full distribution DWARF in the bundled core and the PGXS bridge.
DUCKDB_CFLAGS := $(filter-out -flto -flto=% -ffat-lto-objects,$(CPPFLAGS) $(CFLAGS))
DUCKDB_CXXFLAGS := $(filter-out -flto -flto=% -ffat-lto-objects,$(CPPFLAGS) $(CXXFLAGS))
DUCKDB_LDFLAGS := $(filter-out -flto -flto=% -ffat-lto-objects,$(LDFLAGS))

DUCKDB_CMAKE_FLAGS := \
	-DCMAKE_C_FLAGS:STRING="$(DUCKDB_CFLAGS)" \
	-DCMAKE_CXX_FLAGS:STRING="$(DUCKDB_CXXFLAGS)" \
	-DCMAKE_EXE_LINKER_FLAGS:STRING="$(DUCKDB_LDFLAGS)" \
	-DCMAKE_SHARED_LINKER_FLAGS:STRING="$(DUCKDB_LDFLAGS)" \
	-DCMAKE_MODULE_LINKER_FLAGS:STRING="$(DUCKDB_LDFLAGS)"
ifeq ($(shell pkg-config --atleast-version=7.85.0 libcurl && echo system),)
DUCKDB_CMAKE_FLAGS += -DCURL_ROOT=$(CURDIR)/.pgsty-curl -DCURL_USE_STATIC_LIBS=ON
endif

# Only the shared core is needed by later PGXS builds with identical inputs.
DUCKDB_CORE := third_party/duckdb/build/$(if $(filter Debug,$(DUCKDB_BUILD)),debug,release)/src/libduckdb.so
DUCKDB_CACHE_KEY := $(shell { \
	cat debian/duckdb-source-sha256; \
	sha256sum debian/patches/series debian/patches/*.patch; \
	printf '%s\n' '$(DUCKDB_COMMIT)'; \
	if test -f debian/duckdb-curl-source-sha256; then cat debian/duckdb-curl-source-sha256; fi; \
	pkg-config --modversion libcurl openssl; \
	$(CXX) --version | head -1; \
	printf '%s\n' '$(DUCKDB_CFLAGS)' '$(DUCKDB_CXXFLAGS)' '$(DUCKDB_LDFLAGS)' '$(DUCKDB_CMAKE_FLAGS)' "$${DUCKDB_BUILD:-Release}" "$${DUCKDB_DISABLE_ASSERTIONS:-0}"; \
} | sha256sum | awk '{print $$1}')
DUCKDB_CACHE_DIR := $(HOME)/.cache/pg_duckdb/$(DUCKDB_CACHE_KEY)

# DuckDB unity objects can exceed the 20 GiB builder limit at eight-way
# concurrency.  Keep its core and the PG bridge inside a two-job token pool;
# callers may lower this further for smaller builders.
DUCKDB_MAX_JOBS ?= 2
export CMAKE_BUILD_PARALLEL_LEVEL := $(DUCKDB_MAX_JOBS)

override_dh_auto_build:
	CFLAGS='$(DUCKDB_CFLAGS)' LDFLAGS='$(DUCKDB_LDFLAGS)' \
		sh scripts/build-distribution-curl.sh '$(CURDIR)/curl-8.23.0' '$(CURDIR)/.pgsty-curl' '$(DUCKDB_MAX_JOBS)'
	if test -s '$(DUCKDB_CACHE_DIR)/libduckdb.so'; then \
		mkdir -p '$(dir $(DUCKDB_CORE))'; \
		cp --reflink=auto '$(DUCKDB_CACHE_DIR)/libduckdb.so' '$(DUCKDB_CORE)'; \
		touch '$(DUCKDB_CORE)'; \
	fi
	+$(MAKE) -j$(DUCKDB_MAX_JOBS) \
		PG_CFLAGS='$(PG_CFLAGS)' PG_CXXFLAGS='$(PG_CXXFLAGS)' LDFLAGS='$(PG_LDFLAGS)' \
		EXTRA_CMAKE_VARIABLES='$(DUCKDB_CMAKE_FLAGS)'
	if ! test -s '$(DUCKDB_CACHE_DIR)/libduckdb.so'; then \
		mkdir -p '$(DUCKDB_CACHE_DIR)'; \
		tmp='$(DUCKDB_CACHE_DIR)/libduckdb.so.'$$$$; \
		cp --reflink=auto '$(DUCKDB_CORE)' "$$tmp" && mv -f "$$tmp" '$(DUCKDB_CACHE_DIR)/libduckdb.so'; \
	fi

override_dh_auto_test:

# The cached core has the same Build-ID in every PG-major package.  A DWZ
# multifile would add a PG-specific debugaltlink to that core's global debug
# path, producing different bytes and preventing dbgsym coinstallation.
# Keep each ELF's DWARF self-contained while retaining normal debug splitting.
# Full DuckDB DWARF exceeds dwz's DIE limit on Ubuntu 24.04. Keep the
# core unchanged here; dh_strip still creates its complete dbgsym below.
override_dh_dwz:
	dh_dwz --no-dwz-multifile -Xlibduckdb.so

# The cached core is intentionally reused across PG majors, so its original
# linker Build-ID would otherwise make every automatic dbgsym package claim
# the same global /usr/lib/debug/.build-id path.  Rewrite only the staged
# copy, after DWZ and before dh_strip, with a deterministic PG-specific note.
# This preserves the cache bytes and lets dh_strip generate a matching debug
# file under a distinct Build-ID path for each PostgreSQL major.
override_dh_strip:
	set -eu; \
	core=$$(find debian -type f -path '*/usr/lib/postgresql/*/lib/libduckdb.so' -print -quit); \
	test -n "$$core"; \
	pg=$$(basename "$$(dirname "$$(dirname "$$core")")"); \
	note=$$(mktemp --tmpdir pg-duckdb-build-id.XXXXXX); \
	trap 'rm -f "$$note"' EXIT; \
	python3 -c 'import hashlib,pathlib,struct,sys; pg,path,out=sys.argv[1:]; digest=hashlib.sha1(pathlib.Path(path).read_bytes()+pg.encode()).digest(); pathlib.Path(out).write_bytes(struct.pack("<III",4,20,3)+b"GNU\0"+digest)' "$$pg" "$$core" "$$note"; \
	objcopy --update-section .note.gnu.build-id="$$note" "$$core"; \
	dh_strip

override_dh_installdocs:
	dh_installdocs --all README.*

%:
	dh $@
