#!/usr/bin/make -f
export DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk
include /usr/share/postgresql-common/pgxs_debian_control.mk
PG_VERSIONS := $(shell tr '\n' ' ' < debian/pgversions)
PHP_VERSION := $(shell php-config --version | cut -d. -f1-2)

%:
	dh $@

override_dh_auto_clean:

override_dh_auto_test:
	# Installed-package SQL tests run in the isolated matrix harness.

override_dh_auto_build:

# PHP's unversioned SONAME is not covered by Debian's shlibs metadata.
override_dh_gencontrol:
	dh_gencontrol -- -Vphp:Depends=libphp$(PHP_VERSION)-embed

override_dh_auto_install:
	set -e; for v in $(PG_VERSIONS); do \
		$(MAKE) -C . PG_CONFIG=/usr/lib/postgresql/$$v/bin/pg_config  clean; \
		$(MAKE) -C . PG_CONFIG=/usr/lib/postgresql/$$v/bin/pg_config  CFLAGS="$(CFLAGS)" CXXFLAGS="$(CXXFLAGS) -fPIC" -j2; \
		$(MAKE) -C . PG_CONFIG=/usr/lib/postgresql/$$v/bin/pg_config  install DESTDIR=$(CURDIR)/debian/postgresql-$$v-plphp; \
	done
	rm -rf debian/postgresql-*-plphp/usr/share/doc/postgresql-doc-*
