+/*
+ * Copy the owner, strictness, execution attributes, configuration and comment
+ * from each legacy OID to the expanded public function.  CREATE OR REPLACE
+ * leaves the legacy OID's raw ACL, including its grantor graph, untouched.
+ * The new expanded function receives the same non-owner effective EXECUTE
+ * grantees and grant options; because that function did not exist before the
+ * migration, those grants are normalized as direct owner grants.  A
+ * SECURITY DEFINER compatibility wrapper also needs bridge EXECUTE for its
+ * owner even when that owner had explicitly revoked direct execution on the
+ * old function.
+ *
+ * Security labels are provider-specific and cannot be cloned generically;
+ * abort atomically rather than silently losing one.
+ */
+DO $dbt2_metadata$
+DECLARE
+    pair RECORD;
+    legacy_oid OID;
+    target_oid OID;
+    apply_oid OID;
+    source_meta RECORD;
+    acl_entry RECORD;
+    grantee_sql TEXT;
+    setting TEXT;
+    setting_name TEXT;
+    setting_value TEXT;
+    previous_setting TEXT;
+    source_comment TEXT;
+    target_identity TEXT;
+BEGIN
+    FOR pair IN
+        SELECT *
+          FROM (VALUES
+            ('dbt2_legacy_045_new_order(integer,integer,integer,integer,integer,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info)',
+             'new_order(integer,integer,integer,integer,integer,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info,new_order_info)'),
+            ('dbt2_legacy_045_order_status(integer,integer,integer,text)',
+             'order_status(integer,integer,integer,text)'),
+            ('dbt2_legacy_045_payment(integer,integer,integer,integer,integer,text,real)',
+             'payment(integer,integer,integer,integer,integer,text,real)')
+          ) AS functions(source_name, target_name)
+    LOOP
+        legacy_oid := to_regprocedure(pair.source_name);
+        target_oid := to_regprocedure(pair.target_name);
+        IF legacy_oid IS NULL OR target_oid IS NULL THEN
+            RAISE EXCEPTION 'dbt2 migration metadata target missing: % -> %',
+                pair.source_name, pair.target_name;
+        END IF;
+
+        SELECT metadata.*, owner_role.rolname AS owner_name
+          INTO source_meta
+          FROM dbt2_internal_045_to_046_function_metadata AS metadata
+          JOIN pg_roles AS owner_role ON owner_role.oid = metadata.proowner
+         WHERE metadata.source_oid = legacy_oid;
+
+        /* Restore the snapshot onto both the compatibility OID and new API. */
+        FOREACH apply_oid IN ARRAY ARRAY[legacy_oid, target_oid] LOOP
+            target_identity := apply_oid::regprocedure::TEXT;
+
+            EXECUTE format('ALTER FUNCTION %s OWNER TO %I',
+                           target_identity, source_meta.owner_name);
+            EXECUTE format('ALTER FUNCTION %s %s', target_identity,
+                           CASE WHEN source_meta.prosecdef
+                                THEN 'SECURITY DEFINER'
+                                ELSE 'SECURITY INVOKER' END);
+            EXECUTE format('ALTER FUNCTION %s %s', target_identity,
+                           CASE WHEN source_meta.proisstrict
+                                THEN 'RETURNS NULL ON NULL INPUT'
+                                ELSE 'CALLED ON NULL INPUT' END);
+            EXECUTE format('ALTER FUNCTION %s %s', target_identity,
+                           CASE source_meta.provolatile
+                                WHEN 'i' THEN 'IMMUTABLE'
+                                WHEN 's' THEN 'STABLE'
+                                ELSE 'VOLATILE' END);
+            EXECUTE format('ALTER FUNCTION %s PARALLEL %s', target_identity,
+                           CASE source_meta.proparallel
+                                WHEN 's' THEN 'SAFE'
+                                WHEN 'r' THEN 'RESTRICTED'
+                                ELSE 'UNSAFE' END);
+            IF source_meta.proleakproof THEN
+                EXECUTE format('ALTER FUNCTION %s LEAKPROOF', target_identity);
+            END IF;
+            EXECUTE format('ALTER FUNCTION %s COST %s',
+                           target_identity, source_meta.procost);
+            EXECUTE format('ALTER FUNCTION %s ROWS %s',
+                           target_identity, source_meta.prorows);
+            IF source_meta.prosupport <> 0 THEN
+                EXECUTE format('ALTER FUNCTION %s SUPPORT %s',
+                               target_identity,
+                               source_meta.prosupport::regprocedure);
+            END IF;
+
+            EXECUTE format('ALTER FUNCTION %s RESET ALL', target_identity);
+            IF source_meta.proconfig IS NOT NULL THEN
+                FOREACH setting IN ARRAY source_meta.proconfig LOOP
+                    setting_name := split_part(setting, '=', 1);
+                    setting_value := substr(setting, length(setting_name) + 2);
+                    previous_setting := current_setting(setting_name, true);
+                    PERFORM set_config(setting_name, setting_value, true);
+                    EXECUTE format('ALTER FUNCTION %s SET %I FROM CURRENT',
+                                   target_identity, setting_name);
+                    IF previous_setting IS NULL THEN
+                        EXECUTE format('SET LOCAL %I TO DEFAULT', setting_name);
+                    ELSE
+                        PERFORM set_config(setting_name, previous_setting, true);
+                    END IF;
+                END LOOP;
+            END IF;
+
+            IF apply_oid = target_oid THEN
+                /*
+                 * The legacy ACL is already preserved by CREATE OR REPLACE.
+                 * Reset only the newly-created API, using CASCADE so an
+                 * inherited default ACL cannot create a dependency-order
+                 * failure, then reproduce every effective source grant.
+                 */
+                FOR acl_entry IN
+                    SELECT DISTINCT acl.grantee
+                      FROM pg_proc AS p
+                      CROSS JOIN LATERAL
+                           aclexplode(COALESCE(p.proacl,
+                                               acldefault('f', p.proowner))) AS acl
+                     WHERE p.oid = apply_oid
+                LOOP
+                    IF acl_entry.grantee = 0 THEN
+                        grantee_sql := 'PUBLIC';
+                    ELSE
+                        SELECT quote_ident(rolname) INTO grantee_sql
+                          FROM pg_roles WHERE oid = acl_entry.grantee;
+                    END IF;
+                    EXECUTE format(
+                        'REVOKE ALL PRIVILEGES ON FUNCTION %s FROM %s CASCADE',
+                        target_identity, grantee_sql);
+                END LOOP;
+
+                FOR acl_entry IN
+                    SELECT acl.grantee, acl.is_grantable
+                      FROM aclexplode(COALESCE(source_meta.proacl,
+                                               acldefault('f',
+                                                          source_meta.proowner)))
+                           AS acl
+                     WHERE acl.privilege_type = 'EXECUTE'
+                LOOP
+                    IF acl_entry.grantee = 0 THEN
+                        grantee_sql := 'PUBLIC';
+                    ELSE
+                        SELECT quote_ident(rolname) INTO grantee_sql
+                          FROM pg_roles WHERE oid = acl_entry.grantee;
+                    END IF;
+                    EXECUTE format('GRANT EXECUTE ON FUNCTION %s TO %s%s',
+                                   target_identity, grantee_sql,
+                                   CASE WHEN acl_entry.is_grantable
+                                        THEN ' WITH GRANT OPTION' ELSE '' END);
+                END LOOP;
+
+                IF source_meta.prosecdef THEN
+                    EXECUTE format('GRANT EXECUTE ON FUNCTION %s TO %I',
+                                   target_identity, source_meta.owner_name);
+                END IF;
+            END IF;
+
+            source_comment := source_meta.comment;
+            IF source_comment IS NOT NULL THEN
+                EXECUTE format('COMMENT ON FUNCTION %s IS %L',
+                               target_identity, source_comment);
+            END IF;
+        END LOOP;
+    END LOOP;
+END
+$dbt2_metadata$;
