#!/usr/bin/make -f
export DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk
include /usr/share/postgresql-common/pgxs_debian_control.mk
PG_VERSIONS := $(shell tr '\n' ' ' < debian/pgversions)

%:
	dh $@

override_dh_auto_clean:

override_dh_auto_test:
	# Run upstream installcheck against installed packages in isolated clusters.

override_dh_auto_build:

override_dh_auto_install:
	set -e; for v in $(PG_VERSIONS); do \
		$(MAKE) PG_CONFIG=/usr/lib/postgresql/$$v/bin/pg_config clean; \
		$(MAKE) PG_CONFIG=/usr/lib/postgresql/$$v/bin/pg_config CFLAGS="$(CFLAGS)" -j2; \
		$(MAKE) PG_CONFIG=/usr/lib/postgresql/$$v/bin/pg_config install DESTDIR=$(CURDIR)/debian/postgresql-$$v-colnames; \
	done
	rm -rf debian/postgresql-*-colnames/usr/share/doc/postgresql-doc-*
