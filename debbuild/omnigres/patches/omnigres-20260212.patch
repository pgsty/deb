diff --git a/extensions/omni_httpc/CMakeLists.txt b/extensions/omni_httpc/CMakeLists.txt
index 637b85f..b131719 100644
--- a/extensions/omni_httpc/CMakeLists.txt
+++ b/extensions/omni_httpc/CMakeLists.txt
@@ -25,6 +25,26 @@ add_postgresql_extension(
         REQUIRES omni_http omni_types
         TESTS_REQUIRE omni_httpd)
 
+# Preserve the only published predecessor across package replacement.  Omnigres
+# uses versioned module paths, and the omni upgrade hook needs the predecessor's
+# auxiliary control file to discover and rewrite those paths during ALTER
+# EXTENSION.  The 0.1.10 and 0.1.11 SQL ABIs are identical, so the current
+# bug-fixed module is also a safe compatibility implementation before ALTER.
+add_custom_command(
+        TARGET package_omni_httpc_migrations POST_BUILD
+        COMMAND ${CMAKE_COMMAND} -E copy_if_different
+                ${CMAKE_CURRENT_SOURCE_DIR}/omni_httpc--0.1.10.control
+                ${CMAKE_BINARY_DIR}/packaged/extension/omni_httpc--0.1.10.control
+        COMMAND ${CMAKE_COMMAND} -E copy_if_different
+                ${CMAKE_CURRENT_SOURCE_DIR}/omni_httpc--0.1.10--0.1.11.sql
+                ${CMAKE_BINARY_DIR}/packaged/extension/omni_httpc--0.1.10--0.1.11.sql
+        COMMAND ${CMAKE_COMMAND} -E rm -f
+                ${CMAKE_BINARY_DIR}/packaged/omni_httpc--0.1.10.so
+        COMMAND ${CMAKE_COMMAND} -E create_symlink
+                $<TARGET_FILE_NAME:omni_httpc>
+                ${CMAKE_BINARY_DIR}/packaged/omni_httpc--0.1.10.so
+        DEPENDS omni_httpc)
+
 # Raw string literal in ca-bundle.cc
 set_property(TARGET omni_httpc PROPERTY CXX_STANDARD 11)
 
diff --git a/extensions/omni_httpc/omni_httpc--0.1.10.control b/extensions/omni_httpc/omni_httpc--0.1.10.control
new file mode 100644
