diff --git a/extensions/omni_httpc/omni_httpc--0.1.10--0.1.11.sql b/extensions/omni_httpc/omni_httpc--0.1.10--0.1.11.sql
new file mode 100644
index 0000000..16995cd
--- /dev/null
+++ b/extensions/omni_httpc/omni_httpc--0.1.10--0.1.11.sql
@@ -0,0 +1,32 @@
+-- The SQL ABI is unchanged.  Rewrite only C functions that are members of
+-- this extension and still use the predecessor module path.  Updating probin
+-- in place preserves OIDs, owners, ACLs, comments, dependencies, and all
+-- execution attributes.  The retained 0.1.10 compatibility module keeps the
+-- package-replacement window safe before this script is run.
+do $$
+declare
+    rewritten integer;
+begin
+    update pg_catalog.pg_proc p
+       set probin = '$libdir/omni_httpc--0.1.11.so'
+      from pg_catalog.pg_depend d,
+           pg_catalog.pg_extension e,
+           pg_catalog.pg_language l
+     where d.classid = 'pg_catalog.pg_proc'::pg_catalog.regclass
+       and d.objid = p.oid
+       and d.objsubid = 0
+       and d.refclassid = 'pg_catalog.pg_extension'::pg_catalog.regclass
+       and d.refobjid = e.oid
+       and d.refobjsubid = 0
+       and d.deptype = 'e'
+       and e.extname = 'omni_httpc'
+       and p.prolang = l.oid
+       and l.lanname = 'c'
+       and p.probin = '$libdir/omni_httpc--0.1.10.so';
+
+    get diagnostics rewritten = row_count;
+    if rewritten < 2 then
+        raise exception 'expected to rewrite at least two omni_httpc C functions, rewrote %', rewritten;
+    end if;
+end
+$$;
