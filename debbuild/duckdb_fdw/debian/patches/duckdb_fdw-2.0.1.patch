--- a/runtime_guard.c
+++ b/runtime_guard.c
@@ -100,7 +100,38 @@
 	dl_iterate_phdr(duckdb_runtime_scan_loaded_object, &context);
 
 	if (context.pg_duckdb_module_count > 0)
+	{
+		void   *peer_handle;
+		void   *peer_duckdb_symbol = NULL;
+		Dl_info peer_info;
+
+		/* A second loaded libduckdb object is never a supported combination. */
+		if (context.fingerprint.peer_runtime_path != NULL)
+			return DUCKDB_RUNTIME_INCOMPATIBLE;
+
+		memset(&peer_info, 0, sizeof(peer_info));
+		peer_handle = dlopen(context.fingerprint.peer_module_path,
+						 RTLD_LAZY | RTLD_NOLOAD);
+		if (peer_handle != NULL)
+		{
+			peer_duckdb_symbol = dlsym(peer_handle, "duckdb_library_version");
+			dlclose(peer_handle);
+		}
+
+		/*
+		 * pg_duckdb and duckdb_fdw are compatible when dependency lookup from
+		 * the already-loaded peer resolves the DuckDB API to this exact shared
+		 * object.  A static or differently loaded runtime cannot satisfy both
+		 * the symbol-address and object-path checks.
+		 */
+		if (peer_duckdb_symbol == (void *) duckdb_library_version &&
+			dladdr(peer_duckdb_symbol, &peer_info) != 0 &&
+			peer_info.dli_fname != NULL &&
+			strcmp(peer_info.dli_fname, self_info.dli_fname) == 0)
+			return DUCKDB_RUNTIME_COMPATIBLE_PROVEN;
+
 		return DUCKDB_RUNTIME_PEER_LOADED_NEED_VALIDATION;
+	}
 
 	if (context.fingerprint.module_path == NULL)
 		return DUCKDB_RUNTIME_COMPATIBLE_UNPROVEN;
