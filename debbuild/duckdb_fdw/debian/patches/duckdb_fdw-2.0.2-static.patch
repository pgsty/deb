+++ b/build-duckdb.sh
@@ -0,0 +1,37 @@
+#!/bin/sh
+# Build only PIC static archives; caller supplies distribution build/debug flags.
+set -eu
+src=${DUCKDB_SOURCE_DIR:-"$(pwd)/duckdb"}
+build=${DUCKDB_BUILD_DIR:-"$src/build-pgsty"}
+jobs=${DUCKDB_BUILD_JOBS:-2}
+: "${CFLAGS:?distribution CFLAGS required}"
+: "${CXXFLAGS:?distribution CXXFLAGS required}"
+# Avoid the GCC 11 LTO INSERT regression and GNU unique process-wide data binding.
+# PostgreSQL Clang bitcode is built separately by PGXS and remains enabled.
+cmake -S "$src" -B "$build" -G Ninja \
+    -DCMAKE_BUILD_TYPE=None -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
+    -DCMAKE_C_FLAGS="${CPPFLAGS:-} $CFLAGS -DNDEBUG -fno-lto" \
+    -DCMAKE_CXX_FLAGS="${CPPFLAGS:-} $CXXFLAGS -DNDEBUG -fno-lto -fno-gnu-unique" \
+    -DCMAKE_SHARED_LINKER_FLAGS="${LDFLAGS:-}" \
+    -DCMAKE_EXE_LINKER_FLAGS="${LDFLAGS:-}" \
+    -DDUCKDB_EXPLICIT_VERSION=v2.0.0 \
+    -DGIT_COMMIT_HASH=d54cbbe3df17e8e5ce68312f483b4155836112aa \
+    -DBUILD_UNITTESTS=OFF -DBUILD_SHELL=OFF -DDISABLE_UNITY=ON \
+    -DENABLE_SANITIZER=OFF -DENABLE_UBSAN=OFF -DENABLE_JEMALLOC=OFF \
+    '-DDUCKDB_CAPABILITIES=httplib;loadable_extensions'
+cmake --build "$build" --parallel "$jobs" --target \
+    duckdb_static duckdb_httplib duckdb_loadable_extensions \
+    core_functions_extension parquet_extension json_extension icu_extension
+python3 "$src/scripts/generate_static_extension_loader.py" \
+    --output duckdb_static_loader.c \
+    httplib loadable_extensions core_functions parquet json icu
+# Retain license notices for bundled code, under the package's private doc path.
+mkdir -p duckdb-licenses
+cp "$src/LICENSE" duckdb-licenses/DuckDB-LICENSE
+find "$src/third_party" "$src/extension" -type f \
+    \( -iname 'LICENSE' -o -iname 'LICENSE.*' -o -iname 'LICENCE*' -o -iname 'copyright*' -o -iname 'copying*' -o -iname 'notice*' \) \
+    | while IFS= read -r file; do
+        rel=${file#"$src/"}
+        mkdir -p "duckdb-licenses/$(dirname "$rel")"
+        cp "$file" "duckdb-licenses/$rel"
+    done
