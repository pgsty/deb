#!/usr/bin/make -f

# Makefile only uses -Wno-maybe-uninitialized (needed on Ubuntu ppc64el) if CC=gcc
export CC = gcc

include /usr/share/postgresql-common/pgxs_debian_control.mk

FDW_MAX_JOBS ?= 2
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk
FDW_LDFLAGS := $(filter-out -flto -flto=% -ffat-lto-objects,$(LDFLAGS)) -flto=$(FDW_MAX_JOBS)

override_dh_auto_configure:
	test -f duckdb-headers/duckdb.h
	for v in $$(cat debian/pgversions); do test -f /usr/lib/postgresql/$$v/lib/libduckdb.so; done

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_clean:
	# Disable the clean step to avoid cleaning up pre-built binaries

# Keep the runtime provider next to the FDW and limit GCC's native LTO
# workers.  LDFLAGS is link-only here; Clang bitcode retains the PGXS-provided
# -flto=thin mode.
override_dh_auto_install:
	set -eu; for v in $$(cat debian/pgversions); do \
		export PATH=/usr/lib/postgresql/$$v/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; \
		export PG_LDFLAGS="-Wl,-rpath,'\$$\$$ORIGIN'"; \
		ln -sfn /usr/lib/postgresql/$$v/lib/libduckdb.so libduckdb.so; \
		$(MAKE) -j$(FDW_MAX_JOBS) USE_PGXS=1 PG_CPPFLAGS="-I$$(pwd)/duckdb-headers" LDFLAGS='$(FDW_LDFLAGS)'; \
		$(MAKE) -j$(FDW_MAX_JOBS) USE_PGXS=1 PG_CPPFLAGS="-I$$(pwd)/duckdb-headers" LDFLAGS='$(FDW_LDFLAGS)' install DESTDIR="$$(pwd)/debian/postgresql-$$v-duckdb-fdw"; \
		$(MAKE) -j$(FDW_MAX_JOBS) USE_PGXS=1 PG_CPPFLAGS="-I$$(pwd)/duckdb-headers" LDFLAGS='$(FDW_LDFLAGS)' clean; \
	done

override_dh_installdocs:
	dh_installdocs --all README.*

%:
	dh $@
