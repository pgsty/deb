#!/usr/bin/make -f

export CC = gcc
export CXX = g++
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk
include /usr/share/postgresql-common/pgxs_debian_control.mk

FDW_MAX_JOBS ?= 2
# Native GCC LTO has an observed INSERT regression; PGXS LLVM remains enabled.
FDW_LDFLAGS := $(filter-out -flto -flto=% -ffat-lto-objects,$(LDFLAGS)) -fno-lto

override_dh_auto_configure:

override_dh_auto_build:
	DUCKDB_BUILD_JOBS=$(FDW_MAX_JOBS) sh ./build-duckdb.sh

override_dh_auto_test:

# Core archives are built once per source package; each PG major gets its own
# native bridge, LLVM bitcode/index, upstream SQL and package-private docs.
override_dh_auto_install:
	set -eu; for v in $$(cat debian/pgversions); do \
		$(MAKE) -j$(FDW_MAX_JOBS) USE_PGXS=1 PG_CONFIG=/usr/lib/postgresql/$$v/bin/pg_config LDFLAGS='$(FDW_LDFLAGS)'; \
		$(MAKE) USE_PGXS=1 PG_CONFIG=/usr/lib/postgresql/$$v/bin/pg_config LDFLAGS='$(FDW_LDFLAGS)' install DESTDIR="$$(pwd)/debian/postgresql-$$v-duckdb-fdw"; \
		$(MAKE) USE_PGXS=1 PG_CONFIG=/usr/lib/postgresql/$$v/bin/pg_config clean; \
	done
	rm -rf debian/postgresql-*-duckdb-fdw/usr/share/doc/postgresql-doc-*/

override_dh_auto_clean:
	rm -f *.o *.bc duckdb_fdw.so duckdb_static_loader.c
	rm -rf duckdb/build-pgsty duckdb-licenses

override_dh_installdocs:
	dh_installdocs --all README.md duckdb-licenses

# The embedded core exceeds dwz's DIE limit. Keep full DWARF for dh_strip's
# automatic dbgsym split; skip only optional debug-information deduplication.
override_dh_dwz:
	dh_dwz --exclude=duckdb_fdw.so

%:
	dh $@
