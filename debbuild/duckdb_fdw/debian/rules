#!/usr/bin/make -f

# Makefile only uses -Wno-maybe-uninitialized (needed on Ubuntu ppc64el) if CC=gcc
export CC = gcc

include /usr/share/postgresql-common/pgxs_debian_control.mk

override_dh_auto_configure:
	test -f duckdb-headers/duckdb.h
	for v in $$(cat debian/pgversions); do test -f /usr/lib/postgresql/$$v/lib/libduckdb.so; done

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_clean:
	# Disable the clean step to avoid cleaning up pre-built binaries

override_dh_auto_install:
	set -eu; for v in $$(cat debian/pgversions); do \
		export PATH=/usr/lib/postgresql/$$v/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; \
		export PG_LDFLAGS="-Wl,-rpath,'\$$\$$ORIGIN'"; \
		ln -sfn /usr/lib/postgresql/$$v/lib/libduckdb.so libduckdb.so; \
		$(MAKE) USE_PGXS=1 PG_CPPFLAGS="-I$$(pwd)/duckdb-headers"; \
		$(MAKE) USE_PGXS=1 PG_CPPFLAGS="-I$$(pwd)/duckdb-headers" install DESTDIR="$$(pwd)/debian/postgresql-$$v-duckdb-fdw"; \
		$(MAKE) USE_PGXS=1 PG_CPPFLAGS="-I$$(pwd)/duckdb-headers" clean; \
	done

override_dh_installdocs:
	dh_installdocs --all README.*

%:
	dh $@
