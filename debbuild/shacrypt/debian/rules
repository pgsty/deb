#!/usr/bin/make -f

# Makefile only uses -Wno-maybe-uninitialized (needed on Ubuntu ppc64el) if CC=gcc
export CC = gcc

include /usr/share/postgresql-common/pgxs_debian_control.mk

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_clean:
	# Disable the clean step to avoid cleaning up pre-built binaries

override_dh_auto_install:
	+pg_buildext loop postgresql-%v-shacrypt
	set -eu; for v in $$(pg_buildext supported-versions); do \
		root=debian/postgresql-$$v-shacrypt; \
		test -s $$root/usr/lib/postgresql/$$v/lib/shacrypt.so; \
		test -s $$root/usr/share/postgresql/$$v/extension/shacrypt.control; \
		test -s $$root/usr/share/postgresql/$$v/extension/shacrypt--1.1.sql; \
	done

override_dh_installdocs:
	dh_installdocs --all README.*

%:
	dh $@
