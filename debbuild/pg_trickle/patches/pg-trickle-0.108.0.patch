+            WHEN 'get_refresh_history' THEN 'pgtrickle.get_refresh_history(text, integer)'
+            WHEN 'refresh_timeline' THEN 'pgtrickle.refresh_timeline(integer)'
+            WHEN 'st_refresh_stats' THEN 'pgtrickle.st_refresh_stats()'
