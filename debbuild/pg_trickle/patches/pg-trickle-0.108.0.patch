+       row_probe_version,
+       window_strategy,
+       created_at,
+       updated_at,
+       defining_search_path,
+       now() - st.last_refresh_at AS staleness,
+       CASE WHEN st.schedule IS NOT NULL
+                 AND st.schedule !~ '[\s@]'
+            THEN EXTRACT(EPOCH FROM (now() - st.last_refresh_at)) >
+                 pgtrickle.parse_duration_seconds(st.schedule)
+            ELSE NULL::boolean
+       END AS stale,
+       CASE WHEN st.topk_limit IS NOT NULL THEN TRUE ELSE FALSE END AS is_topk
+FROM pgtrickle.pgt_stream_tables st;
+
+REVOKE ALL ON TABLE pgtrickle.stream_tables_info FROM PUBLIC;
+DO $clear_stream_tables_info_acl$
+DECLARE
+    grant_row RECORD;
+    grantee_sql TEXT;
+BEGIN
+    FOR grant_row IN
+        SELECT DISTINCT x.grantee, c.relowner
+        FROM pg_class AS c
+        CROSS JOIN LATERAL aclexplode(
+            COALESCE(c.relacl, acldefault('r', c.relowner))
+        ) AS x
+        WHERE c.oid = 'pgtrickle.stream_tables_info'::regclass
+          AND x.grantee <> c.relowner
+    LOOP
+        grantee_sql := CASE grant_row.grantee
+            WHEN 0 THEN 'PUBLIC'
+            ELSE quote_ident(pg_get_userbyid(grant_row.grantee))
+        END;
+        EXECUTE format(
+            'REVOKE ALL PRIVILEGES ON TABLE pgtrickle.stream_tables_info FROM %s',
+            grantee_sql
+        );
+    END LOOP;
+END
+$clear_stream_tables_info_acl$;
+DO $restore_stream_tables_info_acl$
+DECLARE
+    item JSONB;
+    grantee_sql TEXT;
+BEGIN
+    FOR item IN
+        SELECT value
+        FROM jsonb_array_elements(
+            current_setting('pg_trickle._upgrade_090_stream_tables_info_acl')::jsonb
+        ) AS saved(value)
+    LOOP
+        IF (item->>'owner')::boolean THEN
+            CONTINUE;
+        END IF;
+        IF item->>'privilege' NOT IN (
+            'SELECT', 'INSERT', 'UPDATE', 'DELETE', 'TRUNCATE',
+            'REFERENCES', 'TRIGGER'
+        ) THEN
+            RAISE EXCEPTION 'unexpected saved stream_tables_info ACL entry: %', item;
+        END IF;
+        grantee_sql := CASE item->>'grantee'
+            WHEN 'PUBLIC' THEN 'PUBLIC'
+            ELSE quote_ident(item->>'grantee')
+        END;
+        EXECUTE format(
+            'GRANT %s ON TABLE pgtrickle.stream_tables_info TO %s%s',
+            item->>'privilege',
+            grantee_sql,
+            CASE WHEN (item->>'grantable')::boolean
+                 THEN ' WITH GRANT OPTION' ELSE '' END
+        );
+    END LOOP;
+END
+$restore_stream_tables_info_acl$;
 
