+        FROM pg_proc AS p
+        CROSS JOIN LATERAL aclexplode(
+            COALESCE(p.proacl, acldefault('f', p.proowner))
+        ) AS x
+        WHERE p.oid IN (
+            'pgtrickle.get_refresh_history(text,integer)'::regprocedure,
+            'pgtrickle.refresh_timeline(integer)'::regprocedure,
+            'pgtrickle.st_refresh_stats()'::regprocedure
+        )
+          AND x.grantee <> p.proowner
