diff --git a/sql/pg_trickle--0.81.1--0.82.0.sql b/sql/pg_trickle--0.81.1--0.82.0.sql
index eee308c9878c01386d03965ea16195567e5de2b9..263063ea6927160de0f29a71115f56b795c7a4d9 100644
--- a/sql/pg_trickle--0.81.1--0.82.0.sql
+++ b/sql/pg_trickle--0.81.1--0.82.0.sql
@@ -2,9 +2,102 @@
 
 SELECT set_config('pg_trickle.enabled', 'off', true);
 
--- The composite return type of this SQL-facing function gains rows_updated.
--- Drop the old signature before the v0.82.0 install SQL recreates it.
+-- All three same-input RETURNS TABLE functions gain rows_updated. Preserve
+-- their EXECUTE ACLs across the mandatory DROP/CREATE while keeping DROP's
+-- default RESTRICT behavior for user object dependencies.
+SELECT set_config(
+    'pg_trickle._upgrade_082_saved_function_acl',
+    COALESCE(jsonb_agg(jsonb_build_object(
+        'function', p.proname,
+        'grantee', CASE WHEN x.grantee = 0 THEN 'PUBLIC'
+                        ELSE pg_get_userbyid(x.grantee) END,
+        'owner', x.grantee = p.proowner,
+        'grantable', x.is_grantable
+    ) ORDER BY p.proname, x.grantee), '[]'::jsonb)::text,
+    true
+)
+FROM pg_proc AS p
+CROSS JOIN LATERAL aclexplode(
+    COALESCE(p.proacl, acldefault('f', p.proowner))
+) AS x
+WHERE p.oid IN (
+    'pgtrickle.get_refresh_history(text,integer)'::regprocedure,
+    'pgtrickle.refresh_timeline(integer)'::regprocedure,
+    'pgtrickle.st_refresh_stats()'::regprocedure
+)
+  AND x.privilege_type = 'EXECUTE';
+
+DO $upgrade_082_function_metadata_gate$
+BEGIN
+    IF EXISTS (
+        SELECT 1
+        FROM pg_proc AS p
+        JOIN pg_extension AS e ON e.extname = 'pg_trickle'
+        WHERE p.oid IN (
+            'pgtrickle.get_refresh_history(text,integer)'::regprocedure,
+            'pgtrickle.refresh_timeline(integer)'::regprocedure,
+            'pgtrickle.st_refresh_stats()'::regprocedure
+        )
+          AND (
+              p.proowner <> e.extowner
+              OR p.proconfig IS NOT NULL
+              OR obj_description(p.oid, 'pg_proc') IS NOT NULL
+          )
+    ) THEN
+        RAISE EXCEPTION
+            'pg_trickle 0.82.0 upgrade blocked: a replaced statistics function has non-default owner, configuration, or comment'
+            USING HINT = 'Export and explicitly normalize or plan restoration of that function metadata before retrying; EXECUTE ACLs are preserved automatically.';
+    END IF;
+END
+$upgrade_082_function_metadata_gate$;
+
+SELECT set_config(
+    'pg_trickle._upgrade_082_saved_view_acl',
+    COALESCE(jsonb_agg(jsonb_build_object(
+        'grantee', CASE WHEN x.grantee = 0 THEN 'PUBLIC'
+                        ELSE pg_get_userbyid(x.grantee) END,
+        'owner', x.grantee = c.relowner,
+        'privilege', x.privilege_type,
+        'grantable', x.is_grantable
+    ) ORDER BY x.grantee, x.privilege_type), '[]'::jsonb)::text,
+    true
+)
+FROM pg_class AS c
+CROSS JOIN LATERAL aclexplode(
+    COALESCE(c.relacl, acldefault('r', c.relowner))
+) AS x
+WHERE c.oid = 'pgtrickle.pg_stat_stream_tables'::regclass;
+
+DO $pg_stat_stream_tables_metadata_gate$
+BEGIN
+    IF EXISTS (
+        SELECT 1
+        FROM pg_class AS c
+        JOIN pg_extension AS e ON e.extname = 'pg_trickle'
+        WHERE c.oid = 'pgtrickle.pg_stat_stream_tables'::regclass
+          AND (
+              c.relowner <> e.extowner
+              OR c.reloptions IS NOT NULL
+              OR obj_description(c.oid, 'pg_class') IS NOT NULL
+              OR EXISTS (
+                  SELECT 1 FROM pg_attribute AS a
+                  WHERE a.attrelid = c.oid
+                    AND a.attnum > 0 AND NOT a.attisdropped
+                    AND a.attacl IS NOT NULL
+              )
+          )
+    ) THEN
+        RAISE EXCEPTION
+            'pg_trickle 0.82.0 upgrade blocked: pgtrickle.pg_stat_stream_tables has non-default owner, options, comment, or column ACLs'
+            USING HINT = 'Export and explicitly normalize or plan restoration of that metadata before retrying; relation ACLs are preserved automatically.';
+    END IF;
+END
+$pg_stat_stream_tables_metadata_gate$;
+
 DROP FUNCTION IF EXISTS pgtrickle.get_refresh_history(text, integer);
+DROP FUNCTION IF EXISTS pgtrickle.refresh_timeline(integer);
+DROP FUNCTION IF EXISTS pgtrickle.st_refresh_stats();
+DROP VIEW IF EXISTS pgtrickle.pg_stat_stream_tables RESTRICT;
 
 ALTER TABLE pgtrickle.pgt_scheduler_jobs
     ADD COLUMN IF NOT EXISTS dispatch_tick_id BIGINT,
@@ -21,6 +114,267 @@ ALTER TABLE pgtrickle.pgt_refresh_history
 ALTER TABLE pgtrickle.pgt_refresh_summary
     ADD COLUMN IF NOT EXISTS total_rows_updated BIGINT NOT NULL DEFAULT 0;
 
+CREATE FUNCTION pgtrickle.get_refresh_history(
+    "name" TEXT,
+    "max_rows" INT DEFAULT 20
+) RETURNS TABLE (
+    "refresh_id" bigint,
+    "data_timestamp" timestamp with time zone,
+    "start_time" timestamp with time zone,
+    "end_time" timestamp with time zone,
+    "action" TEXT,
+    "status" TEXT,
+    "rows_inserted" bigint,
+    "rows_updated" bigint,
+    "rows_deleted" bigint,
+    "duration_ms" double precision,
+    "error_message" TEXT
