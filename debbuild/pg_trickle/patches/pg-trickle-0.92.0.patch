+        EXECUTE format(
+            'GRANT %s ON TABLE pgtrickle.pg_stat_stream_tables TO %s%s',
+            item->>'privilege',
+            grantee_sql,
+            CASE WHEN (item->>'grantable')::boolean
+                 THEN ' WITH GRANT OPTION' ELSE '' END
+        );
+    END LOOP;
+END
+$restore_view_acl$;
