#!/usr/bin/make -f

# Makefile only uses -Wno-maybe-uninitialized (needed on Ubuntu ppc64el) if CC=gcc
export CC = gcc

include /usr/share/postgresql-common/pgxs_debian_control.mk

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_clean:

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_auto_install:
	+pg_buildext loop postgresql-%v-partman
	rm -rf debian/postgresql-*-partman/usr/share/doc/postgresql-doc-*/
	find debian/postgresql-*-partman/usr/lib/postgresql -type f -name '*.py' \
	    -exec sed -i '1s|^#!/usr/bin/env python$$|#!/usr/bin/python3|' {} +

override_dh_installdocs:
	dh_installdocs --all README.*

%:
	dh $@
