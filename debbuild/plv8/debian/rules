#!/usr/bin/make -f

# Makefile only uses -Wno-maybe-uninitialized (needed on Ubuntu ppc64el) if CC=gcc
export CC = gcc
# Resolve Debian's C++ flags so OPTFLAGS below carries hardening and DWARF
# into the wrapper objects that upstream builds outside the normal PGXS path.
export CXXFLAGS = $(shell dpkg-buildflags --get CXXFLAGS)
# Upstream builds its wrapper objects from OPTFLAGS rather than CXXFLAGS.
# Carry Debian's full hardening and DWARF flags into those objects as well.
export OPTFLAGS = -std=c++17 -fno-rtti $(CXXFLAGS)

include /usr/share/postgresql-common/pgxs_debian_control.mk

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_clean:
	# Disable the clean step to avoid cleaning up pre-built binaries

override_dh_dwz:
	# Bundled V8 emits more DIEs than Bookworm's dwz can process. dh_strip still
	# splits the complete DWARF into the automatic dbgsym packages.

override_dh_auto_install:
	+pg_buildext loop postgresql-%v-plv8

override_dh_installdocs:
	dh_installdocs --all README.*

%:
	dh $@
