Subject: Serialize icollection using the JSON envelope its input expects

Preserve value_type, quote integer keys, and JSON-escape non-null values just
as collection_out does. This restores text COPY and pg_dump/pg_restore.

--- a/src/icollection_io.c
+++ b/src/icollection_io.c
@@ -22,6 +22,7 @@
 #include "utils/builtins.h"
 #include "utils/expandeddatum.h"
 #include "utils/lsyscache.h"
+#include "utils/json.h"
 
 #include "collection.h"
 
@@ -58,6 +59,9 @@
 	ICollectionHeader *hdr;
 	icollection *cur;
 	int			count;
+	Oid			outfuncoid;
+	bool		typisvarlena;
+	char	   *value_type;
 	StringInfoData buf;
 
 	hdr = fetch_icollection(fcinfo, 0);
@@ -66,31 +70,33 @@
 	if (count == 0)
 		PG_RETURN_CSTRING("{}");
 
+	getTypeOutputInfo(hdr->value_type, &outfuncoid, &typisvarlena);
+	value_type = format_type_extended(hdr->value_type, -1, FORMAT_TYPE_FORCE_QUALIFY);
+
 	initStringInfo(&buf);
-	appendStringInfoString(&buf, "{");
+	appendStringInfoString(&buf, "{\"value_type\": ");
+	escape_json(&buf, value_type);
+	appendStringInfoString(&buf, ", \"entries\": {");
 
 	for (cur = hdr->head; cur != NULL; cur = cur->hh.next)
 	{
-		appendStringInfo(&buf, "%lld: ", (long long) cur->key);
+		appendStringInfo(&buf, "\"%lld\": ", (long long) cur->key);
 
 		if (cur->isnull)
 			appendStringInfoString(&buf, "null");
 		else
 		{
-			Oid			outfuncoid;
-			bool		typisvarlena;
 			char	   *value_str;
 
-			getTypeOutputInfo(hdr->value_type, &outfuncoid, &typisvarlena);
 			value_str = DatumGetCString(OidFunctionCall1(outfuncoid, cur->value));
-			appendStringInfoString(&buf, value_str);
+			escape_json(&buf, value_str);
 		}
 
 		if (cur->hh.next != NULL)
 			appendStringInfoString(&buf, ", ");
 	}
 
-	appendStringInfoString(&buf, "}");
+	appendStringInfoString(&buf, "}}");
 
 	PG_RETURN_CSTRING(buf.data);
 }
