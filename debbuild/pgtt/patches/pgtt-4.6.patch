 /*
+ * Apply pgtt's public template policy after every template creation path.
+ *
+ * REVOKE must precede GRANT because ALTER DEFAULT PRIVILEGES can otherwise
+ * give a newly created unlogged table more PUBLIC privileges than pgtt
+ * intends. Named-role ACLs and ownership are deliberately left untouched.
+ * The caller must already be connected to SPI.
+ */
+static void
+gtt_set_public_template_acl(const char *relname)
+{
+	char   *newQueryString;
+	int		result;
+
+	newQueryString = psprintf("REVOKE ALL PRIVILEGES ON TABLE %s.%s FROM public",
+			quote_identifier(pgtt_namespace_name),
+			quote_identifier(relname));
+	result = SPI_exec(newQueryString, 0);
+	if (result < 0)
+		ereport(ERROR, (errmsg("execution failure on query: \"%s\"", newQueryString)));
+	pfree(newQueryString);
+
+	newQueryString = psprintf("GRANT SELECT ON TABLE %s.%s TO public",
+			quote_identifier(pgtt_namespace_name),
+			quote_identifier(relname));
+	result = SPI_exec(newQueryString, 0);
+	if (result < 0)
+		ereport(ERROR, (errmsg("execution failure on query: \"%s\"", newQueryString)));
+	pfree(newQueryString);
+}
