#!/usr/bin/make -f
export DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk
include /usr/share/postgresql-common/pgxs_debian_control.mk
PG_VERSIONS := $(shell tr '\n' ' ' < debian/pgversions)

%:
	dh $@

override_dh_auto_clean:

override_dh_auto_test:
	# Installed-package SQL tests run in the isolated matrix harness.

override_dh_auto_build:
	set -e; for v in $(PG_VERSIONS); do \
		PATH=/usr/lib/postgresql/$$v/bin:$$PATH cmake -S . -B build-pg$$v -DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_SKIP_RPATH=ON; \
		cmake --build build-pg$$v -j2; \
	done

override_dh_auto_install:
	set -e; for v in $(PG_VERSIONS); do \
		DESTDIR=$(CURDIR)/debian/postgresql-$$v-pgexporter-ext cmake --install build-pg$$v; \
	done
