#!/bin/sh

set -e

case "$1" in
    configure)
        # Create the service account before the debhelper snippets below apply
        # the tmpfiles definition, which chowns the runtime directory to it.
        # The getent guards keep this idempotent and independent of adduser
        # option changes across the supported Debian and Ubuntu releases.
        if ! getent group haproxy >/dev/null; then
            addgroup --system --quiet haproxy
        fi
        if ! getent passwd haproxy >/dev/null; then
            adduser --system --quiet --ingroup haproxy \
                    --home /var/lib/haproxy --no-create-home \
                    --disabled-login haproxy
        fi
    ;;
esac

#DEBHELPER#

if [ "$1" = configure ] && [ -n "$2" ]; then
    # HAProxy is a load balancer: reload the running instance instead of
    # restarting it. The reload path validates the configuration and then
    # signals the master to re-execute, which picks up the freshly installed
    # binary while established connections drain on the previous workers.
    # A stopped service stays stopped.
    invoke-rc.d haproxy reload || true
fi

exit 0
