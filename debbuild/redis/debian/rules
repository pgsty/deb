#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_LDFLAGS_MAINT_APPEND = -ldl -latomic

include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/buildflags.mk

ifneq ($(DEB_HOST_GNU_TYPE),)
CC = $(DEB_HOST_GNU_TYPE)-gcc
endif

export CC CFLAGS CPPFLAGS LDFLAGS

ifneq (,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
	NUMJOBS = $(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
	MAKEFLAGS += -j$(NUMJOBS)
	export MAKEFLAGS
endif

%:
	dh $@

override_dh_auto_install:
	:

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start
	dh_installsystemd --no-enable --no-start --name=redis-sentinel
	test -n "$$(find debian/redis -type f -path '*/systemd/system/redis.service' -print -quit)"
	test -n "$$(find debian/redis -type f -path '*/systemd/system/redis-sentinel.service' -print -quit)"

execute_after_dh_link:
	test -x debian/redis/usr/bin/redis-server
	test ! -L debian/redis/usr/bin/redis-server
	test "$$(readlink debian/redis/usr/bin/redis-check-rdb)" = redis-server
	test "$$(readlink debian/redis/usr/bin/redis-check-aof)" = redis-server
	test "$$(readlink debian/redis/usr/bin/redis-sentinel)" = redis-server

override_dh_auto_build:
	dh_auto_build --parallel -- V=1 MALLOC=jemalloc BUILD_TLS=yes BUILD_WITH_SYSTEMD=yes

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	# Avoid race conditions in upstream testsuite.
	./utils/gen-test-certs.sh
	./runtest --clients 1 --verbose --no-latency \
		--skiptest "diskless no replicas drop during rdb pipe" \
		--skiptest "diskless slow replicas drop during rdb pipe" \
		--skiptest "diskless fast replicas drop during rdb pipe" \
		--skiptest "diskless all replicas drop during rdb pipe"
	# TclTLS can deadlock on large bidirectional buffers in containers. Both
	# skipped cases are exercised by the normal suite above.
	./runtest --clients 1 --tls --verbose --no-latency \
		--skiptest "For unauthenticated clients output buffer is limited" \
		--skiptest "Test child sending info" \
		--skiptest "diskless no replicas drop during rdb pipe" \
		--skiptest "diskless slow replicas drop during rdb pipe" \
		--skiptest "diskless fast replicas drop during rdb pipe" \
		--skiptest "diskless all replicas drop during rdb pipe"
	./runtest-sentinel
endif

override_dh_auto_clean:
	dh_auto_clean
	rm -f src/release.h
	rm -rf utils/tests
	rm -rf tests/tls
	rm -f tests/tmp/*

override_dh_installchangelogs:
	dh_installchangelogs --keep 00-RELEASENOTES
