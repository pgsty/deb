#!/usr/bin/make -f

export CC = gcc
include /usr/share/postgresql-common/pgxs_debian_control.mk

%:
	dh $@

override_dh_auto_build:

override_dh_auto_test:
	# Runtime regression tests run against an isolated installed-package cluster.

override_dh_auto_install:
	+pg_buildext loop postgresql-%v-jev
	rm -rf debian/postgresql-*-jev/usr/share/doc/postgresql-doc-*/

override_dh_installdocs:
	dh_installdocs --all README.md
