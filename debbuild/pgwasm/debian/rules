#!/usr/bin/make -f

SRC_DIR := pgwasm
PKG_NAME := pgwasm
PG_VERSIONS := $(shell tr '\n' ' ' < debian/pgversions)

%:
	dh $@

override_dh_auto_test:

override_dh_auto_build:
	# Disable the build step since binaries are pre-built.

override_dh_auto_clean:
	# Keep the pre-built pgrx artifacts for packaging.

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_auto_install:
	for PG_VERSION in $(PG_VERSIONS); do \
	    DIR_NAME=$(SRC_DIR)-pg$$PG_VERSION; \
	    FULL_NAME=postgresql-$$PG_VERSION-$(PKG_NAME); \
	    dh_installdirs -p$$FULL_NAME; \
	    mkdir -p $(CURDIR)/debian/$$FULL_NAME/usr/lib/postgresql/$$PG_VERSION/lib; \
	    mkdir -p $(CURDIR)/debian/$$FULL_NAME/usr/share/postgresql/$$PG_VERSION/extension; \
	    cp target/release/$$DIR_NAME/usr/lib/postgresql/$$PG_VERSION/lib/pgwasm.so $(CURDIR)/debian/$$FULL_NAME/usr/lib/postgresql/$$PG_VERSION/lib/; \
	    cp target/release/$$DIR_NAME/usr/share/postgresql/$$PG_VERSION/extension/pgwasm.control $(CURDIR)/debian/$$FULL_NAME/usr/share/postgresql/$$PG_VERSION/extension/; \
	    cp target/release/$$DIR_NAME/usr/share/postgresql/$$PG_VERSION/extension/pgwasm*.sql $(CURDIR)/debian/$$FULL_NAME/usr/share/postgresql/$$PG_VERSION/extension/; \
	done
