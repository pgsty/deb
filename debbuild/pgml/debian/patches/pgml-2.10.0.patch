@@ -157,0 +158,12 @@
+def estimator_num_features(estimator):
+    """Return a usable feature count after estimator deserialization."""
+    num_features = getattr(estimator, "n_features_in_", 0)
+    if not num_features:
+        # CatBoost 1.2.x resets n_features_in_ to zero after pickle.loads(),
+        # while retaining one entry per input feature in feature_names_.
+        num_features = len(getattr(estimator, "feature_names_", []))
+    if not num_features:
+        raise ValueError("estimator does not expose a positive feature count")
+    return num_features
+
