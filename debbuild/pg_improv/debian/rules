#!/usr/bin/make -f

PG_VERSIONS := $(shell tr '\n' ' ' < debian/pgversions)

%:
	dh $@ --with pgxs

override_dh_auto_build:
	# cargo-pgrx packages are built by the outer recipe with locked dependencies.

override_dh_auto_clean:
	# Preserve the binaries prepared by the outer recipe.

override_dh_auto_test:
	# Run installed-package integration tests in a disposable PostgreSQL instance.

override_dh_pgxs_test:
	# This Rust workspace has no PGXS installcheck target. Use upstream txn.sh
	# and finance.sh against the installed package instead.

override_dh_auto_install:
	set -e; for PG_VERSION in $(PG_VERSIONS); do \
	    PKG=postgresql-$$PG_VERSION-pg-improv; \
	    DIR=crates/pg_improv/target/release/pg_improv-pg$$PG_VERSION; \
	    mkdir -p debian/$$PKG/usr/lib/postgresql/$$PG_VERSION/lib debian/$$PKG/usr/share/postgresql/$$PG_VERSION/extension; \
	    cp $$DIR/usr/lib/postgresql/$$PG_VERSION/lib/pg_improv.so debian/$$PKG/usr/lib/postgresql/$$PG_VERSION/lib/; \
	    cp $$DIR/usr/share/postgresql/$$PG_VERSION/extension/* debian/$$PKG/usr/share/postgresql/$$PG_VERSION/extension/; \
	    cp crates/pg_improv/sql/pg_improv--*.sql debian/$$PKG/usr/share/postgresql/$$PG_VERSION/extension/; \
	done
