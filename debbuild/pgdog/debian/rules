#!/usr/bin/make -f

export DH_VERBOSE=1
CARGO_PROFILE_RELEASE_DEBUG ?= 2
CARGO_PROFILE_RELEASE_STRIP ?= none
export CARGO_PROFILE_RELEASE_DEBUG CARGO_PROFILE_RELEASE_STRIP

%:
	dh $@ --without autoreconf

# Cargo verifies the vendored source checksums; retain upstream configure inputs.
override_dh_update_autotools_config:
	:

override_dh_auto_build:
	@set -eu; export RUSTUP_TOOLCHAIN=1.96.1; export GIT_HASH=3f2b2ea; \
	export RUSTFLAGS="--cfg tokio_unstable"; \
	if [ "$$(dpkg --print-architecture)" = "arm64" ]; then \
		export RUSTFLAGS="$$RUSTFLAGS -C target-feature=+lse"; \
	fi; \
	unset MAKEFLAGS MFLAGS; \
	PATH=$$HOME/.cargo/bin:$$PATH CARGO_NET_OFFLINE=true cargo build --release --locked -p pgdog; \
	test "$$(sha256sum Cargo.lock | awk '{print $$1}')" = aec2ae575d6a84fa01ea676eac22b26748c968160f07bda34480f88516948e6f; \
	target/release/pgdog --version | grep -Fq 'PgDog v0.1.63 (3f2b2ea)'; \
	target/release/pgdog -c debian/pgdog.toml -u debian/users.toml configcheck

override_dh_auto_clean:
	rm -rf target

override_dh_auto_test:
	:

override_dh_auto_install:
	:

override_dh_installsystemd:
	dh_installsystemd --no-start

override_dh_installdocs:
	dh_installdocs
	install -D -m 0644 vendor/pgraw-prod/pg_raw_parse/LICENSE-APACHE debian/pgdog/usr/share/doc/pgdog/third-party/pg_raw_parse-LICENSE-APACHE
	install -D -m 0644 vendor/pgraw-prod/pg_raw_parse/LICENSE-MIT debian/pgdog/usr/share/doc/pgdog/third-party/pg_raw_parse-LICENSE-MIT
	install -D -m 0644 vendor/pgraw-prod/pg_raw_parse/libpg_query/LICENSE debian/pgdog/usr/share/doc/pgdog/third-party/libpg_query-LICENSE
	install -D -m 0644 vendor/pgraw-prod/pg_raw_parse/libpg_query/src/postgres/COPYRIGHT debian/pgdog/usr/share/doc/pgdog/third-party/PostgreSQL-COPYRIGHT
	install -D -m 0644 vendor/scram/scram/LICENSE debian/pgdog/usr/share/doc/pgdog/third-party/scram-LICENSE
	install -D -m 0644 vendor/pg-internals/pg_internals/LICENSE debian/pgdog/usr/share/doc/pgdog/third-party/pg_internals-LICENSE
	install -D -m 0644 vendor/pg-internals/pg_internals/vendor/postgres/COPYRIGHT debian/pgdog/usr/share/doc/pgdog/third-party/pg_internals-PostgreSQL-COPYRIGHT
