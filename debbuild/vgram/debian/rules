#!/usr/bin/make -f
export DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk
include /usr/share/postgresql-common/pgxs_debian_control.mk
PG_VERSIONS := $(shell tr '\n' ' ' < debian/pgversions)

%:
	dh $@

override_dh_auto_clean:

override_dh_auto_test:
	# Installed-package SQL tests run in the isolated matrix harness.

override_dh_auto_build:

override_dh_auto_install:
	set -e; for v in $(PG_VERSIONS); do \
		$(MAKE) -C . PG_CONFIG=/usr/lib/postgresql/$$v/bin/pg_config USE_PGXS=1 clean; \
		$(MAKE) -C . PG_CONFIG=/usr/lib/postgresql/$$v/bin/pg_config USE_PGXS=1 CFLAGS="$(CFLAGS)" CXXFLAGS="$(CXXFLAGS) -fPIC" -j2; \
		$(MAKE) -C . PG_CONFIG=/usr/lib/postgresql/$$v/bin/pg_config USE_PGXS=1 install DESTDIR=$(CURDIR)/debian/postgresql-$$v-vgram; \
	done
	rm -rf debian/postgresql-*-vgram/usr/share/doc/postgresql-doc-*
