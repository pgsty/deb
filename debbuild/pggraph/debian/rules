#!/usr/bin/make -f

SRC_DIR := graph
EXT_NAME := graph
PKG_NAME := pggraph
PG_VERSIONS := $(shell tr '\n' ' ' < debian/pgversions)

%:
	dh $@

override_dh_auto_test:

override_dh_auto_build:
	# Built by the outer Makefile via cargo pgrx package.

override_dh_auto_clean:
	# Keep pre-built artifacts for packaging.

override_dh_auto_install:
	for PG_VERSION in $(PG_VERSIONS); do \
	    DIR_NAME=$(EXT_NAME)-pg$$PG_VERSION; \
	    FULL_NAME=postgresql-$$PG_VERSION-$(PKG_NAME); \
	    dh_installdirs -p$$FULL_NAME; \
	    mkdir -p $(CURDIR)/debian/$$FULL_NAME/usr/lib/postgresql/$$PG_VERSION/lib; \
	    mkdir -p $(CURDIR)/debian/$$FULL_NAME/usr/share/postgresql/$$PG_VERSION/extension; \
	    cp $(SRC_DIR)/target/release/$$DIR_NAME/usr/lib/postgresql/$$PG_VERSION/lib/$(EXT_NAME).so $(CURDIR)/debian/$$FULL_NAME/usr/lib/postgresql/$$PG_VERSION/lib/; \
	    cp $(SRC_DIR)/target/release/$$DIR_NAME/usr/share/postgresql/$$PG_VERSION/extension/$(EXT_NAME).control $(CURDIR)/debian/$$FULL_NAME/usr/share/postgresql/$$PG_VERSION/extension/; \
	    cp $(SRC_DIR)/target/release/$$DIR_NAME/usr/share/postgresql/$$PG_VERSION/extension/$(EXT_NAME)*.sql $(CURDIR)/debian/$$FULL_NAME/usr/share/postgresql/$$PG_VERSION/extension/; \
	    EXT_DIR=$(CURDIR)/debian/$$FULL_NAME/usr/share/postgresql/$$PG_VERSION/extension; \
	    test "$$(find $$EXT_DIR -maxdepth 1 -type f -name 'graph*.sql' | wc -l)" -eq 3; \
	    test -f $$EXT_DIR/graph--1.0.0--1.1.0.sql; \
	    test -f $$EXT_DIR/graph--1.1.0--1.2.0.sql; \
	    test -f $$EXT_DIR/graph--1.2.0.sql; \
	    printf 'postgresql:Depends=postgresql-%s\n' "$$PG_VERSION" >> debian/$$FULL_NAME.substvars; \
	    printf 'postgresql:Breaks=\n' >> debian/$$FULL_NAME.substvars; \
	done

override_dh_installdocs:
	dh_installdocs --all README.md NOTICE
