#!/usr/bin/make -f

export CC = gcc
export LIBDIR = /usr/lib/jvm/default-java/lib/server
export PG_LDFLAGS = -Wl,-rpath,/usr/lib/jvm/default-java/lib/server

include /usr/share/postgresql-common/pgxs_debian_control.mk

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_clean:
	rm -f *.class

override_dh_auto_install:
	+pg_buildext loop postgresql-%v-jdbc-fdw
	rm -rf debian/postgresql-*-jdbc-fdw/usr/share/doc/postgresql-doc-*/

override_dh_installdocs:
	dh_installdocs --all README.md

%:
	dh $@
