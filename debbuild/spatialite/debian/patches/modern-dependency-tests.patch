 #include <stdlib.h>
 #include <stdio.h>
 #include <string.h>
+#include <math.h>
 
 #include <spatialite/gaiaconfig.h>
 
 #include "sqlite3.h"
 #include "spatialite.h"
 #include <spatialite/gaiaaux.h>
+
+/* Huge coordinate text may differ between SQLite printf precisions while
+ * representing exactly the same binary64 value. Keep every other byte exact. */
+static int
+compare_large_coordinates (const char *left, const char *right)
+{
+    while (*left && *right)
+      {
+          if (*left >= '0' && *left <= '9' && *right >= '0' && *right <= '9')
+            {
+                char *left_end;
+                char *right_end;
+                double a = strtod (left, &left_end);
+                double b = strtod (right, &right_end);
+                if (left_end - left >= 100 && right_end - right >= 100
+                    && isfinite (a) && isfinite (b) && a == b)
+                  {
+                      left = left_end;
+                      right = right_end;
+                      continue;
+                  }
+            }
+          if (*left != *right)
+              return 1;
+          ++left;
+          ++right;
+      }
+    return *left != *right;
+}
 
