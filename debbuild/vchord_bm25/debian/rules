#!/usr/bin/make -f

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

SRC_DIR := vchord_bm25
PKG_NAME := vchord-bm25
CARGO_TARGET_DIR ?= $(CURDIR)/target

%:
	dh $@

override_dh_dwz:

override_dh_auto_build:
	# Disable the build step since binaries are pre-built

override_dh_auto_clean:
	# Disable the clean step to avoid cleaning up pre-built binaries

override_dh_auto_test:
	# Disable the test step since we don't have tests

override_dh_auto_install:
	set -e; for PG_VERSION in $$(cat debian/pgversions); do \
	    DIR_NAME=$(SRC_DIR)-pg$$PG_VERSION; \
	    FULL_NAME=postgresql-$$PG_VERSION-$(PKG_NAME); \
	    dh_installdirs -p$$FULL_NAME; \
	    mkdir -p $(CURDIR)/debian/$$FULL_NAME/usr/lib/postgresql/$$PG_VERSION/lib; \
	    mkdir -p $(CURDIR)/debian/$$FULL_NAME/usr/share/postgresql/$$PG_VERSION/extension; \
	    cp $(CARGO_TARGET_DIR)/release/$$DIR_NAME/usr/lib/postgresql/$$PG_VERSION/lib/*.so $(CURDIR)/debian/$$FULL_NAME/usr/lib/postgresql/$$PG_VERSION/lib/; \
	    cp $(CARGO_TARGET_DIR)/release/$$DIR_NAME/usr/share/postgresql/$$PG_VERSION/extension/* $(CURDIR)/debian/$$FULL_NAME/usr/share/postgresql/$$PG_VERSION/extension/; \
	done

# The compiled module uses symbols added by the November 2026 security minors.
override_dh_gencontrol:
	set -e; for pg in $$(cat debian/pgversions); do \
		case "$$pg" in \
			19) minimum=19.0 ;; \
			18) minimum=18.7 ;; \
			17) minimum=17.12 ;; \
			16) minimum=16.16 ;; \
			15) minimum=15.20 ;; \
			*) echo "unsupported PostgreSQL major: $$pg" >&2; exit 1 ;; \
		esac; \
		built=$$(/usr/lib/postgresql/$$pg/bin/pg_config --version); \
		built=$${built#PostgreSQL }; built=$${built%% *}; \
		dpkg --compare-versions "$$built" ge "$$minimum"; \
		dh_gencontrol -ppostgresql-$$pg-vchord-bm25 -- -Vpostgresql:Depends="postgresql-$$pg (>= $$minimum)"; \
	done
